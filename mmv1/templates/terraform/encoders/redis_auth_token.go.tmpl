// If the user passed a full cluster or user resource ID instead of a short name,
// extract any unset project/region and normalize cluster and user_id to short names
// before mutex and URL templates are evaluated.
isConfigured := func(key string) bool {
	rawCfg := d.GetRawConfig()
	if !rawCfg.IsNull() && rawCfg.Type().IsObjectType() && rawCfg.Type().HasAttribute(key) {
		attr := rawCfg.GetAttr(key)
		return !attr.IsNull() && !(attr.IsKnown() && attr.Type() == cty.String && attr.AsString() == "")
	}
	v, ok := d.GetOk(key)
	return ok && v.(string) != ""
}

cluster := d.Get("cluster").(string)
if parts := redisClusterFullIdRegex.FindStringSubmatch(cluster); parts != nil {
	if !isConfigured("project") {
		if err := d.Set("project", parts[1]); err != nil {
			return nil, fmt.Errorf("Error setting project: %s", err)
		}
	}
	if !isConfigured("region") {
		if err := d.Set("region", parts[2]); err != nil {
			return nil, fmt.Errorf("Error setting region: %s", err)
		}
	}
	if err := d.Set("cluster", parts[3]); err != nil {
		return nil, fmt.Errorf("Error setting cluster: %s", err)
	}
} else if cluster != "" {
	if err := d.Set("cluster", tpgresource.GetResourceNameFromSelfLink(cluster)); err != nil {
		return nil, fmt.Errorf("Error setting cluster: %s", err)
	}
}

if userId := d.Get("user_id").(string); userId != "" {
	if parts := redisClusterUserFullIdRegex.FindStringSubmatch(userId); parts != nil {
		if !isConfigured("project") {
			if err := d.Set("project", parts[1]); err != nil {
				return nil, fmt.Errorf("Error setting project: %s", err)
			}
		}
		if !isConfigured("region") {
			if err := d.Set("region", parts[2]); err != nil {
				return nil, fmt.Errorf("Error setting region: %s", err)
			}
		}
		if err := d.Set("user_id", parts[4]); err != nil {
			return nil, fmt.Errorf("Error setting user_id: %s", err)
		}
	} else {
		if err := d.Set("user_id", tpgresource.GetResourceNameFromSelfLink(userId)); err != nil {
			return nil, fmt.Errorf("Error setting user_id: %s", err)
		}
	}
}

// API request body expects an empty object for custom action :addAuthToken
return map[string]interface{}{}, nil
