package faulttesting

import (
	"fmt"
	"net/http"
	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
	"github.com/hashicorp/terraform-provider-google/google/tpgresource"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"
)


func DataSourceGoogleFaultTestingExperiment() *schema.Resource {
	// Generate datasource schema from resource
	dsSchema := tpgresource.DatasourceSchemaFromResourceSchema(ResourceFaultTestingExperiment().Schema)

	// Set 'Required' schema elements
	tpgresource.AddRequiredFieldsToSchema(dsSchema, "experiment_id", "location")
	// Set 'Optional' schema elements
	tpgresource.AddOptionalFieldsToSchema(dsSchema, "project")

	return &schema.Resource{
		Read:   DataSourceGoogleFaultTestingExperimentRead,
		Schema: dsSchema,
	}
}

func DataSourceGoogleFaultTestingExperimentRead(d *schema.ResourceData, meta interface{}) error {
	config := meta.(*transport_tpg.Config)
	userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return err
	}

	location, err := tpgresource.GetLocation(d, config)
	if err != nil {
		return err
	}

	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return err
	}

	id := fmt.Sprintf("projects/%s/locations/%s/experiments/%s", project, location, d.Get("experiment_id").(string))
	d.SetId(id)

	url, err := tpgresource.ReplaceVars(d, config, "{{"{{"}}FaultTestingBasePath{{"}}"}}projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}location{{"}}"}}/experiments/{{"{{"}}experiment_id{{"}}"}}")
	if err != nil {
		return err
	}

	billingProject := ""
	billingProject = project

	// err == nil indicates that the billing_project value was found
	if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
		billingProject = bp
	}

	headers := make(http.Header)
	res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    url,
		UserAgent: userAgent,
		Headers:   headers,
	})
	if err != nil {
		return transport_tpg.HandleNotFoundError(err, d, fmt.Sprintf("FaultTestingExperiment %q", d.Id()))
	}

	if err := d.Set("project", project); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}

	if err := d.Set("create_time", flattenFaultTestingExperimentCreateTime(res["createTime"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("description", flattenFaultTestingExperimentDescription(res["description"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("display_name", flattenFaultTestingExperimentDisplayName(res["displayName"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("effective_action", flattenFaultTestingExperimentEffectiveAction(res["effectiveAction"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("end_notes", flattenFaultTestingExperimentEndNotes(res["endNotes"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("end_reason", flattenFaultTestingExperimentEndReason(res["endReason"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("experiment_template", flattenFaultTestingExperimentExperimentTemplate(res["experimentTemplate"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("name", flattenFaultTestingExperimentName(res["name"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("start_time", flattenFaultTestingExperimentStartTime(res["startTime"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("state", flattenFaultTestingExperimentState(res["state"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("state_update_time", flattenFaultTestingExperimentStateUpdateTime(res["stateUpdateTime"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("stop_time", flattenFaultTestingExperimentStopTime(res["stopTime"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("experiment_template_description", flattenFaultTestingExperimentExperimentTemplateDescription(res["templateDescription"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("experiment_template_display_name", flattenFaultTestingExperimentExperimentTemplateDisplayName(res["templateDisplayName"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}
	if err := d.Set("experiment_template_duration", flattenFaultTestingExperimentExperimentTemplateDuration(res["templateDuration"], d, config)); err != nil {
		return fmt.Errorf("Error reading Experiment: %s", err)
	}

	if err := tpgresource.SetDataSourceLabels(d); err != nil {
		return err
	}

	if d.Id() == "" {
		return fmt.Errorf("%s not found", id)
	}
	return nil
}
